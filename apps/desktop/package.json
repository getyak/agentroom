{
  "name": "@agentstudio/desktop",
  "version": "0.2.0-alpha.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "AgentRoom desktop app (Electron, macOS)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:mac": "electron-vite build && node package-mac.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p e2e-smoke/tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e:smoke": "electron-vite build && playwright test -c e2e-smoke/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@agentstudio/brand": "workspace:*",
    "@agentstudio/core": "workspace:*",
    "@agentstudio/personal": "workspace:*",
    "lucide-react": "^1.66.0",
    "matrix-js-sdk": "45.0.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
